# Copy this file to `.env` and fill in real values. NEVER commit your real .env.

# Environment: "development" or "production".
# In production the app refuses to start unless SECRET_KEY is changed from the default.
ENVIRONMENT=development

# Security
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_EXPIRATION_MINUTES=30

# Database
# Dev (SQLite):     sqlite:///./data/virtual_wiscard.db
# Prod (Postgres):  postgresql://user:password@host:5432/wiscard
DATABASE_URL=sqlite:///./data/virtual_wiscard.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Blockchain (Optional - for NFT features)
CONTRACT_ADDRESS=
PROVIDER_URL=https://polygon-mumbai.g.alchemy.com/v2/your-api-key
CHAIN_ID=80001

# Apple Wallet (Optional)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.edu.wisc.wiscard
APPLE_CERT_PATH=/path/to/cert.p12
